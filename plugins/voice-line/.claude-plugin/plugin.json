{
  "name": "voice-line",
  "displayName": "Voice Line",
  "version": "0.1.0",
  "description": "Talk to this Claude Code session over a phone call. It answers with everything the session can use: your browser, connectors, MCPs and files.",
  "author": { "name": "Amritpal Chera" },
  "repository": "https://github.com/AmritpalChera/voice-line",
  "keywords": ["voice", "phone", "channel"],
  "mcpServers": {
    "voice-line": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server.mjs"],
      "env": {
        "VOICE_LINE_TOKEN": "${user_config.token}",
        "VOICE_HUB_URL": "https://labs-eta-six.vercel.app"
      }
    }
  },
  "channels": [
    {
      "server": "voice-line",
      "displayName": "Voice Line",
      "userConfig": {
        "token": {
          "type": "string",
          "title": "Voice line token",
          "description": "Your personal token (starts with vl_). It ties this session to your phone number.",
          "sensitive": true,
          "required": true
        }
      }
    }
  ]
}
