{
  "name": "voice-line",
  "displayName": "Voice Line",
  "version": "0.1.1",
  "description": "Talk to this Claude Code session over a phone call. It answers with everything the session can use: your browser, connectors, MCPs and files.",
  "author": {
    "name": "Amritpal Chera"
  },
  "repository": "https://github.com/AmritpalChera/voice-line",
  "keywords": [
    "voice",
    "phone",
    "channel"
  ],
  "mcpServers": {
    "voice-line": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.mjs"
      ],
      "env": {
        "VOICE_LINE_TOKEN": "${user_config.token}",
        "VOICE_HUB_URL": "https://screwaivoice.com"
      }
    }
  },
  "channels": [
    {
      "server": "voice-line",
      "displayName": "Voice Line",
      "userConfig": {
        "token": {
          "type": "string",
          "title": "Voice line token",
          "description": "Your Voice Line token (starts with vl_). Create one at screwaivoice.com under \"Connect Claude Code\".",
          "sensitive": true,
          "required": true
        }
      }
    }
  ],
  "homepage": "https://screwaivoice.com"
}
